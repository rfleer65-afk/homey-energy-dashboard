{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.drpeppers.energydashboard",
  "version": "0.2.26",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Energy Dashboard",
    "nl": "Energie Dashboard"
  },
  "description": {
    "en": "A live energy dashboard for any screen in your home",
    "nl": "Een live energiedashboard voor elk scherm in huis"
  },
  "category": [
    "energy"
  ],
  "tags": {
    "en": [
      "energy",
      "dashboard",
      "solar",
      "p1",
      "boiler"
    ],
    "nl": [
      "energie",
      "dashboard",
      "zonnepanelen",
      "p1",
      "boiler"
    ]
  },
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation",
    "homey:app:com.gruijter.powerhour"
  ],
  "brandColor": "#20C07C",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DrPeppers",
    "email": "drpeppers@duck.com"
  },
  "homepage": "https://github.com/WNijhof/homey-energy-dashboard",
  "source": "https://github.com/WNijhof/homey-energy-dashboard",
  "support": "https://github.com/WNijhof/homey-energy-dashboard/issues",
  "homeyCommunityTopicId": 160116,
  "bugs": {
    "url": "https://github.com/WNijhof/homey-energy-dashboard/issues"
  },
  "api": {
    "getSettingsInfo": {
      "method": "GET",
      "path": "/settings-info"
    },
    "getDiagnosisReport": {
      "method": "GET",
      "path": "/diagnosis-report"
    },
    "importNights": {
      "method": "POST",
      "path": "/night-import"
    },
    "clearNightImport": {
      "method": "POST",
      "path": "/night-import/clear"
    },
    "getShowerLog": {
      "method": "GET",
      "path": "/shower-log"
    },
    "removeShower": {
      "method": "POST",
      "path": "/shower-log/remove"
    }
  },
  "flow": {
    "actions": [
      {
        "title": {
          "en": "Shower started",
          "nl": "Douche gestart"
        },
        "hint": {
          "en": "Only used when calibrating the shower minutes is turned on in the app settings. Run it when the shower is turned on.",
          "nl": "Alleen in gebruik als het ijken van de doucheminuten aanstaat in de app-instellingen. Voer het uit als de douche aangaat."
        },
        "id": "shower-start"
      },
      {
        "title": {
          "en": "Shower finished",
          "nl": "Douche klaar"
        },
        "hint": {
          "en": "Only used when calibrating the shower minutes is turned on in the app settings. Run it when the shower is turned off.",
          "nl": "Alleen in gebruik als het ijken van de doucheminuten aanstaat in de app-instellingen. Voer het uit als de douche uitgaat."
        },
        "id": "shower-stop"
      },
      {
        "title": {
          "nl": "Registreer warm tapwater via bron",
          "en": "Record hot tap water source"
        },
        "titleFormatted": {
          "nl": "Registreer warm tapwater via [[source]]: [[reason]]",
          "en": "Record hot tap water via [[source]]: [[reason]]"
        },
        "hint": {
          "nl": "Plaats na een geslaagde klepopdracht. Registreert de aangestuurde bron, niet de fysieke klepstand. Alleen een gewijzigde bron komt in de laatste drie; de eerste registratie is een beginstand.",
          "en": "Place after a successful valve command. Records the commanded source, not physical valve position. Only changed sources enter the last three; the first report is a baseline."
        },
        "args": [
          {
            "name": "source",
            "type": "dropdown",
            "values": [
              {
                "id": "boiler",
                "title": {
                  "nl": "Direct uit boiler",
                  "en": "Direct from storage tank"
                }
              },
              {
                "id": "cv",
                "title": {
                  "nl": "Via cv-ketel (naverwarming)",
                  "en": "Via gas boiler (boost)"
                }
              }
            ]
          },
          {
            "name": "reason",
            "type": "text",
            "placeholder": {
              "nl": "Reden (mag leeg blijven)",
              "en": "Reason (may be empty)"
            }
          }
        ],
        "id": "tapwater-source"
      }
    ]
  },
  "widgets": {
    "energy-flow": {
      "name": {
        "en": "Energy flows",
        "nl": "Energiestromen"
      },
      "height": 260,
      "transparent": false,
      "settings": [
        {
          "id": "perZone",
          "type": "number",
          "title": {
            "en": "Devices per room",
            "nl": "Apparaten per ruimte"
          },
          "value": 3,
          "min": 0,
          "max": 8
        },
        {
          "id": "animate",
          "type": "checkbox",
          "title": {
            "en": "Moving flows",
            "nl": "Bewegende stromen"
          },
          "value": true
        }
      ],
      "api": {
        "getFlow": {
          "method": "GET",
          "path": "/flow"
        }
      },
      "id": "energy-flow"
    },
    "energy-now": {
      "name": {
        "en": "Energy now",
        "nl": "Energie nu"
      },
      "height": 220,
      "transparent": false,
      "settings": [
        {
          "id": "show",
          "type": "dropdown",
          "title": {
            "en": "Show",
            "nl": "Tonen"
          },
          "value": "now",
          "values": [
            {
              "id": "now",
              "title": {
                "en": "Power now (W)",
                "nl": "Vermogen nu (W)"
              }
            },
            {
              "id": "both",
              "title": {
                "en": "Power now and kWh today",
                "nl": "Vermogen nu en kWh vandaag"
              }
            },
            {
              "id": "today",
              "title": {
                "en": "kWh today",
                "nl": "kWh vandaag"
              }
            }
          ]
        },
        {
          "id": "animate",
          "type": "checkbox",
          "title": {
            "en": "Moving flows",
            "nl": "Bewegende stromen"
          },
          "value": true
        }
      ],
      "api": {
        "getNow": {
          "method": "GET",
          "path": "/now"
        }
      },
      "id": "energy-now"
    },
    "groups": {
      "name": {
        "en": "Circuits",
        "nl": "Groepen"
      },
      "height": 240,
      "transparent": false,
      "settings": [
        {
          "id": "perPhase",
          "type": "checkbox",
          "title": {
            "en": "Per phase, with Other",
            "nl": "Per fase, met Overig"
          },
          "value": true
        },
        {
          "id": "unit",
          "type": "dropdown",
          "title": {
            "en": "Load in",
            "nl": "Belasting in"
          },
          "value": "A",
          "values": [
            {
              "id": "A",
              "title": {
                "en": "Amps",
                "nl": "Ampère"
              }
            },
            {
              "id": "W",
              "title": {
                "en": "Watts",
                "nl": "Watt"
              }
            }
          ]
        },
        {
          "id": "devices",
          "type": "checkbox",
          "title": {
            "en": "Devices that use the most",
            "nl": "Apparaten die het meest gebruiken"
          },
          "value": false
        }
      ],
      "api": {
        "getGroups": {
          "method": "GET",
          "path": "/groups"
        }
      },
      "id": "groups"
    }
  }
}
